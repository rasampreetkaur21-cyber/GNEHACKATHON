{
  "name": "claimshield-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "db:init": "npm --prefix backend run db:init",
    "seed": "npm --prefix backend run seed",
    "reviewer:create": "npm --prefix backend run reviewer:create",
    "company:staff": "node backend/src/cli.js company-staff",
    "live:qa": "node backend/scripts/live-qa.js",
    "import:ora": "node backend/src/cli.js import",
    "start": "npm --prefix backend start",
    "postinstall": "npm --prefix backend ci",
    "company:import": "node backend/src/cli.js company",
    "dataset:validate": "python datasets/six-product-v1/scripts/validate_dataset.py datasets/six-product-v1/data",
    "dataset:test": "python -m unittest discover -s datasets/six-product-v1/tests -v",
    "dataset:index": "node backend/scripts/index-provenance.js",
    "benchmark:requests": "python backend/scripts/generate-requests.py",
    "benchmark:policy": "node backend/scripts/benchmark-device-policy.js",
    "local-ai:setup": "python backend/local_ai/setup.py",
    "local-ai:train": "python backend/local_ai/train.py"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "9.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.18",
    "vite": "^6.4.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "7.0.3",
    "dotenv": "^17.2.3",
    "express": "4.22.3",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  }
}
